# Skopiuj ten plik jako .env i uzupełnij. Pliku .env NIE dodajemy do repozytorium.

# Dowolny długi losowy ciąg znaków. Można wygenerować poleceniem:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=zmien-mnie

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Baza danych (te same wartości czyta kontener PostgreSQL)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgres://app:app@db:5432/app
